# Settings for a real run. Copy this file to .env (git-ignored) and fill it in:
#
#     cp .env.example .env
#
# `rj` and tools/connections.py load .env. A variable that is already set in the shell wins over its
# line here. Keep comments on lines of their own. The stub run (`make offline`) needs none of this.

# HarnessRouter: the account every session runs in. Both are required; the code holds no default URL.
# The address below is HarnessRouter Cloud's as the plan records it. A Community Edition on your own
# machine is at http://localhost:3000/api/harness by the same record (set `access.edition: ce` in profiles.yaml).
HR_BASE_URL=https://api.harnessrouter.ai
HR_API_KEY=your-harnessrouter-key

# TokenRouter: `rj` calls it directly for the adaptive answer, one preflight check and the usage figure,
# and for the blind judge where profiles.yaml says `judge.provider: tokenrouter`. Required.
TR_API_KEY=your-tokenrouter-key
# Optional. The default is https://api.tokenrouter.com/v1
# TR_BASE_URL=https://api.tokenrouter.com/v1

# The blind judge of the demo profile is Claude on the Anthropic API (`judge.provider: anthropic`): `rj judge`
# calls it with this key and pays for it there. Required for `rj judge` under such a profile.
# ANTHROPIC_API_KEY=your-anthropic-key

# Provider keys for the connections of the HarnessRouter account. Optional. tools/connections.py sets a
# connection from each key that is present (see its --dry mode first), the Anthropic key above among them;
# `rj` calls no provider with the others. A base URL is optional too; without one the provider's own
# address is used (the judge's calls follow ANTHROPIC_BASE_URL as well).
# ANTHROPIC_BASE_URL=
# OPENAI_API_KEY=your-openai-key
# Any OpenAI-compatible endpoint:
# OPENAI_BASE_URL=
